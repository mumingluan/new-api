+		duration := int64(setting.TokenRateLimitDurationMinutes * 60)
+		recordRedisRequest(ctx, rdb, successKey, successMaxCount, duration)
+	} else {
+		duration := int64(setting.TokenRateLimitDurationMinutes * 60)
