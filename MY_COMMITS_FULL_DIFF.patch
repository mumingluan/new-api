+// recordTokenRateLimitSuccess 记录分钟级成功请求
+func recordTokenRateLimitSuccess(c *gin.Context) {
+	if !setting.TokenRateLimitEnabled {
+		return
+	}
+
+	tokenId := common.GetContextKeyInt(c, constant.ContextKeyTokenId)
+	if tokenId == 0 {
+		return
+	}
